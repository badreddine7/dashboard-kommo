{
  "name": "kommo-pulse-backend",
  "version": "2.0.0",
  "description": "Backend API for Kommo Pulse CRM Analytics Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "node setup-stripe.js",
    "db:show": "node show-database.js",
    "db:migrate": "node -e \"require('./database').initializeTables()\"",
    "db:backup": "node -e \"require('./scripts/database-maintenance.js').manualBackup()\"",
    "db:optimize": "node -e \"require('./scripts/database-maintenance.js').manualOptimization()\"",
    "db:status": "node -e \"require('./scripts/database-maintenance.js').getMaintenanceStatus().then(console.log)\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": ["crm", "analytics", "kommo", "api", "stripe"],
  "author": "Kommo Pulse Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "stripe": "^14.0.0",
    "nodemailer": "^6.9.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "eslint": "^8.55.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/badreddine7/kommo-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/badreddine7/dashboard-kommo/issues"
  },
  "homepage": "https://github.com/badreddine7/dashboard-kommo#readme"
}
