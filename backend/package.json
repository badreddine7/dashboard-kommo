{
  "name": "kommo-pulse-backend",
  "version": "2.0.0",
  "description": "Backend API for Kommo Pulse CRM Analytics Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "node setup-stripe.js",
    "db:show": "node show-database.js",
    "db:migrate": "node -e \"require('./database-pg').dbHelpers.initializeTables()\"",
    "db:backup": "node -e \"require('./database-pg').dbHelpers.createBackup().then(console.log)\"",
    "db:cleanup": "node -e \"require('./database-pg').dbHelpers.cleanupOldBackups().then(console.log)\"",
    "db:status": "node -e \"require('./database-pg').dbHelpers.getDatabaseStats().then(console.log)\"",
    "db:test": "node -e \"require('./database-pg').dbHelpers.testConnection().then(console.log)\"",
    "db:setup": "node setup-postgres.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "crm",
    "analytics",
    "kommo",
    "api",
    "stripe"
  ],
  "author": "Kommo Pulse Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.0",
    "pg": "^8.16.3",
    "pg-pool": "^3.10.1",
    "stripe": "^14.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "nodemon": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/badreddine7/kommo-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/badreddine7/dashboard-kommo/issues"
  },
  "homepage": "https://github.com/badreddine7/dashboard-kommo#readme"
}
