# API Configuration
VITE_API_URL=http://localhost:3000

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# App Configuration
VITE_APP_NAME=Kommo Pulse
